# Copy this file to .env and fill in values
# In production, all secrets are loaded from GCP Secret Manager

NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/auto_recruit

# Redis
REDIS_URL=redis://localhost:6379

# GCP
GCP_PROJECT_ID=auto-recruit-kwangel
GCP_REGION=us-central1

# Firebase Auth
FIREBASE_PROJECT_ID=auto-recruit-kwangel
# In production: loaded from Secret Manager
FIREBASE_SERVICE_ACCOUNT_JSON=

# Apollo.io (primary people search)
# In production: loaded from Secret Manager (secret name: apollo-api-key)
APOLLO_API_KEY=

# People Data Labs (secondary / backfill)
# In production: loaded from Secret Manager (secret name: pdl-api-key)
PDL_API_KEY=

# ContactOut (Phase 2)
CONTACTOUT_API_KEY=

# RocketReach (Phase 2)
ROCKETREACH_API_KEY=

# Gmail OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Graph OAuth (Phase 3)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Cloud Storage
STORAGE_BUCKET=auto-recruit-kwangel-exports

# Pub/Sub emulator (local dev only)
# PUBSUB_EMULATOR_HOST=localhost:8085
