{
  "name": "auto-recruit",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @auto-recruit/db generate",
    "db:migrate:dev": "pnpm --filter @auto-recruit/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @auto-recruit/db migrate:deploy",
    "db:push": "pnpm --filter @auto-recruit/db db:push",
    "db:studio": "pnpm --filter @auto-recruit/db studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  }
}
